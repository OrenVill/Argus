{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/OrenVill/Argus/docs/schemas/webhook-v1.json",
  "title": "Argus anomaly webhook v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "env": { "type": "string" },
    "service": { "type": "string" },
    "image_tag": { "type": "string" },
    "template_hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "template": { "type": "string" },
    "level": {
      "type": "string",
      "enum": ["DEBUG", "INFO", "WARN", "ERROR", "FATAL"]
    },
    "anomaly_type": {
      "type": "string",
      "enum": ["NEW_SIGNATURE", "FREQUENCY_SPIKE", "REGRESSION"]
    },
    "surge_multiplier": { "type": "integer", "enum": [10, 100, 1000] },
    "count": { "type": "integer", "minimum": 1 },
    "reported_count": { "type": "integer", "minimum": 0 },
    "sample_lines": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 10
    },
    "first_seen": { "type": "string", "format": "date-time" },
    "last_seen": { "type": "string", "format": "date-time" }
  },
  "required": [
    "env",
    "service",
    "template_hash",
    "template",
    "level",
    "anomaly_type",
    "count",
    "reported_count",
    "sample_lines",
    "first_seen",
    "last_seen"
  ]
}
